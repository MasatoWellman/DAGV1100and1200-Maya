select -ne :standardSurface1;
	setAttr ".bc" -type "float3" 0.40000001 0.40000001 0.40000001 ;
	setAttr ".sr" 0.5;
select -ne :openPBR_shader1;
	setAttr ".bc" -type "float3" 0.40000001 0.40000001 0.40000001 ;
	setAttr ".sr" 0.5;
select -ne :initialShadingGroup;
	setAttr ".ro" yes;
select -ne :initialParticleSE;
	setAttr ".ro" yes;
select -ne :defaultRenderGlobals;
	addAttr -ci true -h true -sn "dss" -ln "defaultSurfaceShader" -dt "string";
	setAttr ".ren" -type "string" "arnold";
	setAttr ".dss" -type "string" "openPBR_shader1";
select -ne :defaultResolution;
	setAttr ".pa" 1;
select -ne :defaultColorMgtGlobals;
	setAttr ".cfe" yes;
	setAttr ".cfp" -type "string" "<MAYA_RESOURCES>/OCIO-configs/Maya2022-default/config.ocio";
	setAttr ".vtn" -type "string" "ACES 1.0 SDR-video (sRGB)";
	setAttr ".vn" -type "string" "ACES 1.0 SDR-video";
	setAttr ".dn" -type "string" "sRGB";
	setAttr ".wsn" -type "string" "ACEScg";
	setAttr ".otn" -type "string" "ACES 1.0 SDR-video (sRGB)";
	setAttr ".potn" -type "string" "ACES 1.0 SDR-video (sRGB)";
select -ne :hardwareRenderGlobals;
	setAttr ".ctrs" 256;
	setAttr ".btrs" 512;
connectAttr "pillow:groupId1.id" "pillow:pCube1Shape.iog.og[0].gid";
connectAttr "pillow:initialShadingGroup.mwc" "pillow:pCube1Shape.iog.og[0].gco";
connectAttr "pillow:polyTweakUV1.out" "pillow:pCube1Shape.i";
connectAttr "pillow:polyTweakUV1.uvtk[0]" "pillow:pCube1Shape.uvst[0].uvtw";
relationship "link" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" ":initialParticleSE.message" ":defaultLightSet.message";
relationship "link" ":lightLinker1" "pillow:initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialParticleSE.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "pillow:initialShadingGroup.message" ":defaultLightSet.message";
connectAttr "layerManager.dli[0]" "defaultLayer.id";
connectAttr "renderLayerManager.rlmi[0]" "defaultRenderLayer.rlid";
connectAttr "pillow:initialShadingGroup1.oc" "pillow:initialShadingGroup.ss";
connectAttr "pillow:groupId1.msg" "pillow:initialShadingGroup.gn" -na;
connectAttr "pillow:pCube1Shape.iog.og[0]" "pillow:initialShadingGroup.dsm" -na;
connectAttr "pillow:initialShadingGroup.msg" "pillow:materialInfo1.sg";
connectAttr "pillow:initialShadingGroup1.msg" "pillow:materialInfo1.m";
connectAttr "pillow:groupParts1.og" "polyAutoProj1.ip";
connectAttr "pillow:pCube1Shape.wm" "polyAutoProj1.mp";
connectAttr "pillow:polySurfaceShape1.o" "pillow:groupParts1.ig";
connectAttr "pillow:groupId1.id" "pillow:groupParts1.gi";
connectAttr "polyAutoProj1.out" "polyPlanarProj1.ip";
connectAttr "pillow:pCube1Shape.wm" "polyPlanarProj1.mp";
connectAttr "polyPlanarProj1.out" "pillow:polyMapCut1.ip";
connectAttr "pillow:polyMapCut1.out" "pillow:polyTweakUV1.ip";
connectAttr "pillow:initialShadingGroup.pa" ":renderPartition.st" -na;
connectAttr "pillow:initialShadingGroup1.msg" ":defaultShaderList1.s" -na;
connectAttr "defaultRenderLayer.msg" ":defaultRenderingList1.r" -na;
// End of pillow111.ma
